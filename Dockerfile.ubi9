# syntax=docker/dockerfile:1

ARG UBI9_IMAGE=registry.access.redhat.com/ubi9/ubi:latest

FROM ${UBI9_IMAGE} AS pytorch-builder

ARG PYTORCH_VERSION=2.14.0
ARG PYTORCH_SOURCE_VERSION=2.14.0a0
# Leave unset by default so the build uses every CPU allocated to its build pod.
# A caller may still pass --build-arg MAX_JOBS=<n> to impose a limit.
ARG MAX_JOBS

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTORCH_BUILD_VERSION=${PYTORCH_VERSION} \
    PYTORCH_BUILD_NUMBER=1 \
    USE_CUDA=0 \
    USE_ROCM=0 \
    USE_DISTRIBUTED=0 \
    USE_KINETO=0 \
    USE_MKLDNN=0 \
    USE_NNPACK=0 \
    BUILD_IGNORE_SVE_UNAVAILABLE=1 \
    BLAS=OpenBLAS

RUN dnf install -y --setopt=install_weak_deps=False \
        autoconf \
        automake \
        ca-certificates \
        cmake \
        gcc \
        gcc-c++ \
        libgomp \
        libtool \
        make \
        ninja-build \
        openblas \
        openblas-devel \
        openssl-devel \
        python3.12 \
        python3.12-devel \
        python3.12-pip \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf

WORKDIR /opt/pytorch

COPY . .

RUN test "$(cat version.txt)" = "${PYTORCH_SOURCE_VERSION}" \
    && test -f third_party/XNNPACK/CMakeLists.txt \
    && python3.12 -m pip install --no-binary :all: \
        --requirement requirements-hermetic.txt \
    && mkdir --parents /opt/wheels \
    && export MAX_JOBS="${MAX_JOBS:-$(nproc)}" \
    && python3.12 -m pip wheel --verbose --wheel-dir /opt/wheels --no-deps \
        --no-build-isolation . \
    && python3.12 -m pip install --no-deps /opt/wheels/torch-*.whl \
    && cd /tmp \
    && python3.12 -c "import torch; print(torch.__version__)"

FROM ${UBI9_IMAGE}

# Keep the build toolchain, source tree, and compiled objects out of the
# published image. Consumers copy this wheel into their own runtime image.
COPY --from=pytorch-builder /opt/wheels/ /opt/wheels/

USER 1001
